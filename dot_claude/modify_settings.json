#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json
#
# stdin is the file as it exists now (empty on a fresh machine); stdout becomes
# the new contents. Only the keys below are owned by chezmoi and end up in git.
# Everything else in the live file passes through untouched, which is the point:
#
#   - Claude Code rewrites this file at runtime (effortLevel, preferredNotifChannel,
#     autoMode.environment, autoMode.soft_deny). A static managed file loses those
#     on every apply.
#   - autoMode.environment describes work infrastructure and OTEL_EXPORTER_OTLP_HEADERS
#     is a live API key. This source repo is public, so neither may be committed.
#   - The telemetry endpoint, the work skills marketplace and the warp plugin are
#     specific to this machine and this employer.
#
# Leaving a key out of MANAGED never deletes it — it just keeps it out of git.
#
# Deliberately unset, so a future pass doesn't "helpfully" add them:
#
#   - askUserQuestionTimeout: questions wait forever on purpose; inputNeededNotifEnabled
#     is what covers being away from the keyboard.
#   - fallbackModel: an overloaded primary should fail loudly rather than silently
#     continue on another model. switchModelsOnFlag: false is the same call.
#
# advisorModel is managed here even though /advisor rewrites it at runtime: this file
# is the source of truth, so a pick made in /advisor is reverted on the next apply.
#
# CLAUDE_CODE_THRIFTY_SONIC=false turns off the undocumented "thrifty_sonic" flag
# (GrowthBook tengu_thrifty_sonic). In auto / bypassPermissions mode it injects an
# instruction to prefer Bash (cat, sed, heredoc) over Read/Edit/Write and trims the
# Bash tool description. Path-scoped rules, nested CLAUDE.md, and the Edit|Write
# hooks below only fire on the dedicated tools, so the flag silently disables all
# of them. Verified on 2.1.263. Drop this once the docs say rules and hooks also
# fire for shell equivalents, or the flag is gone from the binary.
set -euo pipefail

CURRENT=$(cat)
[ -n "$CURRENT" ] || CURRENT='{}'

MANAGED=$(
  cat <<'JSON'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "advisorModel": "fable",
  "language": "Japanese",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(gh secret set *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-safety.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-branch-pr-status.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -re '.tool_input.file_path') && case \"$FILE\" in \"$HOME\"/.local/share/chezmoi/*) exit 0 ;; esac && SOURCE=$(chezmoi source-path \"$FILE\" 2>/dev/null) && echo \"Blocked: chezmoi managed. Edit: $SOURCE\" >&2 && exit 2 || exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -re '.new_string // .content // empty' | grep '^[[:space:]]*\\(//\\|#\\|--\\) *[-=*#/]\\{3,\\}' && { echo 'Warning: Section divider or decorative comments detected. Remove them.' >&2; exit 2; } || exit 0"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/gha-lint.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "enableWorkflows": true,
  "autoCompactEnabled": false,
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "feedbackSurveyRate": 0,
  "cleanupPeriodDays": 365,
  "timeZone": "Asia/Tokyo",
  "timeFormat": "24-hour",
  "keybindingFlavor": "readline",
  "viewMode": "focus",
  "switchModelsOnFlag": false,
  "attribution": {
    "sessionUrl": false
  },
  "sandbox": {
    "enabled": true
  }
}
JSON
)

# jq's `*` recurses into objects but replaces arrays wholesale, so a plain
# `. * $managed` would drop every hook entry the live file has for an event
# MANAGED also defines — Orca injects its relay hooks that way. Keep the
# managed entries authoritative and re-append the unmanaged ones, matched on
# (matcher, commands) so the merge stays idempotent.
printf '%s' "$CURRENT" | jq --argjson managed "$MANAGED" '
  def key: [.matcher, [.hooks[]?.command]];
  . as $live
  | ($live * $managed)
  | reduce ($managed.hooks | keys_unsorted[]) as $ev (.;
      ($managed.hooks[$ev] | map(key)) as $owned
      | .hooks[$ev] = ( $managed.hooks[$ev]
                        + [ ($live.hooks[$ev] // [])[]
                            | select( key as $k | ($owned | any(. == $k)) | not ) ] )
    )
'
